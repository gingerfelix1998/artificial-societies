# Run outputs are reproducible from a config plus a seed; never commit them.
out/

# Theorist source texts are copyrighted material; never commit them.
data/corpora/*
!data/corpora/.gitkeep

# LLM disk cache
.cache/

# Credentials. .env holds a real API key and must never be committed; .env.example is the
# committed template and holds none. A test asserts this rule still applies, because a
# secret committed once stays in the history whether or not it is later removed.
.env
.env.*
!.env.example

# Environments and build artefacts
.venv/
*.nosync/
*.egg-info/
build/
dist/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
