# Template. Copy to .env and fill in:  cp .env.example .env
#
# .env is gitignored and must never be committed. A key committed once stays in the
# history whether or not it is later removed, so treat an accidental commit as a leaked
# key and rotate it rather than editing the history.
#
# This file is only one of the places the SDK looks. An exported ANTHROPIC_API_KEY, or a
# profile from `ant auth login`, both work without it — and an already-exported variable
# wins over this file, so a one-off override needs no edit here.

ANTHROPIC_API_KEY=

# Optional. Only if you use a gateway or proxy rather than the default endpoint.
# ANTHROPIC_BASE_URL=
