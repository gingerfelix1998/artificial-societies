{
  "name": "artsoc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Localhost-only viewer for artsoc simulation sessions. Demoware: it selects among committed arm configs and renders what a session produced.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "json-schema-to-typescript": "^15.0.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
